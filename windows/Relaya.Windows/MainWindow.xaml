<Window x:Class="Relaya.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relaya">
    <Window.SystemBackdrop>
        <!-- Вкладки в заголовке → Mica Alt, как в Windows Terminal. -->
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Свой заголовок: вкладки сессий, справа место под системные кнопки окна. -->
        <Grid x:Name="TitleBar" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Relaya" Margin="16,0,12,0" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
            <TabView x:Name="Tabs" Grid.Column="1" VerticalAlignment="Bottom"
                     IsAddTabButtonVisible="False" TabWidthMode="SizeToContent"
                     TabCloseRequested="OnTabCloseRequested" />
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
                        OpenPaneLength="280" ItemInvoked="OnItemInvoked">
            <NavigationView.PaneFooter>
                <Button Margin="12,4,12,8" HorizontalAlignment="Stretch" Click="OnNewHost">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Новый хост…" />
                    </StackPanel>
                </Button>
            </NavigationView.PaneFooter>
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="Search" PlaceholderText="Поиск хостов" QueryIcon="Find"
                                TextChanged="OnSearchChanged" />
            </NavigationView.AutoSuggestBox>

            <!-- Слой контента поверх Mica: как карточка в Settings Windows 11. -->
            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0"
                  CornerRadius="8,0,0,0">
                <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE756;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="EmptyTitle" Text="Выберите хост слева" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ConfigPath" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
