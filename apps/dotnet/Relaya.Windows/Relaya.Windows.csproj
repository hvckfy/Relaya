<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Relaya</RootNamespace>
    <AssemblyName>Relaya</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- .NET внутри сборки: пользователю не нужно ставить runtime. -->
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\Relaya.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Сгенерированные UniFFI-привязки не проходят наши предупреждения. -->
    <!-- Свой Main (Program.cs): askpass- и MCP-режимы без окна. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <NoWarn>$(NoWarn);CS8618;CS8625;CS8603;CS8604;CS0168</NoWarn>
  </PropertyGroup>
  <!-- Язык интерфейса при сборке (ADR-002): -p:RelayaLang=ru|en; без флага — по языку Windows. -->
  <!-- Самопроверка TerminalView (Relaya.exe с ключом selftest-terminal) — только в CI: -p:RelayaSelftest=true. -->
  <PropertyGroup Condition="'$(RelayaSelftest)' == 'true'">
    <DefineConstants>$(DefineConstants);RELAYA_SELFTEST</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RelayaLang)' == 'ru'">
    <DefineConstants>$(DefineConstants);RELAYA_LANG_RU</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RelayaLang)' == 'en'">
    <DefineConstants>$(DefineConstants);RELAYA_LANG_EN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.0" />
    <!-- Звук удалённого стола: WASAPI (MIT). -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
  </ItemGroup>
  <!-- Общие с Linux страницы, логика и MainWindow. -->
  <Import Project="..\Relaya.Shared\Relaya.Shared.projitems" Label="Shared" />
  <ItemGroup>
    <Content Include="Assets\Relaya.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Переводы общие с Mac: ключи — русские строки, en.lproj — английский. -->
  <ItemGroup>
    <None Include="..\..\..\resources\localization\en.lproj\Localizable.strings" Link="Localization\en.strings"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Rust-ядро: scripts/build-core-windows.ps1 кладёт relaya_core.dll и Relaya.Shared/Core/relaya_core.cs. -->
  <ItemGroup>
    <!-- relaya_core.dll и, при сборке с FreeRDP, его DLL (freerdp3, winpr3, OpenSSL, legacy для NTLM…) — рядом с Relaya.exe. -->
    <None Include="..\..\..\core\target\release\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
