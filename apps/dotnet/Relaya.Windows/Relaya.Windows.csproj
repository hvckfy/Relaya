<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Relaya</RootNamespace>
    <AssemblyName>Relaya</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- .NET внутри сборки: пользователю не нужно ставить runtime. -->
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\Relaya.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Сгенерированные UniFFI-привязки не проходят наши предупреждения. -->
    <!-- Свой Main (Program.cs): askpass- и MCP-режимы без окна. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <NoWarn>$(NoWarn);CS8618;CS8625;CS8603;CS8604;CS0168</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Relaya.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Переводы общие с Mac: ключи — русские строки, en.lproj — английский. -->
  <ItemGroup>
    <None Include="..\..\..\resources\localization\en.lproj\Localizable.strings" Link="Localization\en.strings"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Rust-ядро: scripts/build-core-windows.ps1 кладёт relaya_core.dll и Core/relaya_core.cs. -->
  <ItemGroup>
    <None Include="..\..\..\core\target\release\relaya_core.dll" Link="relaya_core.dll"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\core\target\release\relaya_core.dll')" />
  </ItemGroup>
</Project>
