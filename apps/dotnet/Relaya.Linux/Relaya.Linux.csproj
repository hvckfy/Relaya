<Project Sdk="Uno.Sdk/6.7.30">
  <!-- Linux-клиент: Uno Platform, Skia desktop (X11). Общий код — Relaya.Shared, как у Windows. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <RootNamespace>Relaya</RootNamespace>
    <AssemblyName>relaya</AssemblyName>
    <ApplicationTitle>Relaya</ApplicationTitle>
    <ApplicationId>app.relaya.Relaya</ApplicationId>
    <!-- Skia: SKCanvasElement и SkiaSharp для холста терминала. -->
    <UnoFeatures>Skia</UnoFeatures>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Сгенерированный Core/relaya_core.cs сам отключает nullable-предупреждения (build-core-linux.sh, А9). -->
    <NoWarn>$(NoWarn);Uno0001</NoWarn>
  </PropertyGroup>
  <!-- Язык интерфейса при сборке (ADR-002): -p:RelayaLang=ru|en; без флага — по языку системы. -->
  <PropertyGroup Condition="'$(RelayaLang)' == 'ru'">
    <DefineConstants>$(DefineConstants);RELAYA_LANG_RU</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RelayaLang)' == 'en'">
    <DefineConstants>$(DefineConstants);RELAYA_LANG_EN</DefineConstants>
  </PropertyGroup>
  <!-- Значок в области уведомлений: StatusNotifierItem по D-Bus (Platform/TrayIcon.cs). -->
  <ItemGroup>
    <PackageReference Include="Tmds.DBus" Version="0.21.2" />
  </ItemGroup>
  <Import Project="..\Relaya.Shared\Relaya.Shared.projitems" Label="Shared" />
  <ItemGroup>
    <None Include="..\..\..\resources\localization\en.lproj\Localizable.strings" Link="Localization\en.strings"
          CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\resources\icon\relaya-icon.png" Link="Assets\relaya.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Rust-ядро: scripts/build-core-linux.sh кладёт librelaya_core.so и Relaya.Shared/Core/relaya_core.cs. -->
  <ItemGroup>
    <!-- Ядро и всё, что лежит рядом с ним: FreeRDP и OpenSSL из vcpkg, RoyalVNCKit (ядро ищет их через rpath $ORIGIN). -->
    <None Include="..\..\..\core\target\release\*.so*" CopyToOutputDirectory="PreserveNewest" Visible="false"
          Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
