<Project Sdk="Microsoft.NET.Sdk">
  <!-- Smoke-тест терминала в CI, как в приложении: WinExe без консоли, тот же PseudoConsole.cs,
       вывод через TerminalEmulator ядра с ответами обратно в ConPTY. Результат — в файле (args[0]) и коде выхода. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS8618;CS8625;CS8603;CS8604;CS0168</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Relaya.Windows\Terminal\PseudoConsole.cs" Link="PseudoConsole.cs" />
    <Compile Include="..\Relaya.Shared\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <None Include="..\..\..\core\target\release\relaya_core.dll" Link="relaya_core.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
